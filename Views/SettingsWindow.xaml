<Window x:Class="VisualNovelDetect.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VisualNovelDetect.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
        Title="Visual Novel Detect - Settings"
        Height="620"
        Width="610"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI"
        ResizeMode="NoResize"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#0369A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecordActiveButton" TargetType="Button">
            <Setter Property="Background" Value="#D97706"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#B45309"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title Header -->
            <RowDefinition Height="*"/>    <!-- Tabs -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Visual Novel Detect Settings" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC"/>
            <TextBlock Text="Configure interactive shortcut, floating popup position &amp; APIs" FontSize="12" Foreground="#64748B"/>
        </StackPanel>

        <!-- Tabs Container -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            
            <!-- TAB 1: General & Hotkey -->
            <TabItem Header="Shortcut &amp; Position" Style="{StaticResource TabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <!-- Master Enable Toggle -->
                        <Border Background="#1E293B" CornerRadius="8" Padding="14,10" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,12">
                            <CheckBox IsChecked="{Binding IsLookupEnabled}" Content="Enable Word Lookup &amp; OCR Monitoring" FontWeight="SemiBold"/>
                        </Border>

                        <!-- Interactive Shortcut Recorder Box -->
                        <Border Background="#1E293B" CornerRadius="8" Padding="14" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Global Activation Shortcut" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock Text="Click the box or press 'Record Shortcut', then press keys on your keyboard." FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Interactive Key Capture Box -->
                                    <Border x:Name="ShortcutRecorderBorder"
                                            Focusable="True"
                                            Background="#0F172A"
                                            BorderBrush="#38BDF8"
                                            BorderThickness="2"
                                            CornerRadius="6"
                                            Padding="14,10"
                                            Cursor="Hand"
                                            PreviewMouseLeftButtonDown="ShortcutRecorder_MouseDown">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⌨️ " FontSize="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ShortcutDisplayText}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="#38BDF8"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Record / Cancel Toggle Button -->
                                    <Button Grid.Column="1"
                                            x:Name="BtnRecordToggle"
                                            Style="{StaticResource SecondaryButton}"
                                            Content="🔴 Record"
                                            Click="RecordButton_Click"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Stretch"/>

                                    <!-- Reset Shortcut Button -->
                                    <Button Grid.Column="2"
                                            Style="{StaticResource SecondaryButton}"
                                            Content="Reset Default"
                                            Click="ResetShortcut_Click"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Stretch"/>
                                </Grid>

                                <!-- Helper Hint Text -->
                                <TextBlock Text="{Binding ShortcutHintText}"
                                           FontSize="11.5"
                                           Foreground="#94A3B8"
                                           FontStyle="Italic"
                                           Margin="2,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Popup Fixed Positioning & Movability -->
                        <Border Background="#1E293B" CornerRadius="8" Padding="14" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Popup Screen Position &amp; Movability" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock Text="Position popup at a fixed comfortable area so it never covers visual novel dialogue words." FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,10"/>

                                <CheckBox IsChecked="{Binding UseFixedPosition}"
                                          Content="Use Fixed Screen Position (Recommended for VNs)"
                                          FontWeight="SemiBold"
                                          Margin="0,0,0,8"/>

                                <TextBlock Text="When enabled, you can drag the ✥ Move icon on the top-right of the popup to place it anywhere. The app will automatically remember your preferred position!"
                                           FontSize="11.5"
                                           Foreground="#94A3B8"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Current Position: " FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding FixedPositionSummary}" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="Reset Position &amp; Size"
                                            Command="{Binding ResetPopupPositionCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Mouse Trigger -->
                        <Border Background="#1E293B" CornerRadius="8" Padding="14" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Mouse Middle-Click Trigger" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                                <CheckBox IsChecked="{Binding EnableMiddleClickTrigger}" Content="Trigger lookup on Middle-Mouse Click over words" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Dialogue Region -->
                        <Border Background="#1E293B" CornerRadius="8" Padding="14" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Fixed Dialogue Box Region (Optional)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock Text="When defined, OCR prioritizes the designated box instead of cursor radius." FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,8"/>

                                <TextBlock Text="{Binding DialogueRegionSummary}" FontSize="12" Foreground="#38BDF8" Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SecondaryButton}" Content="Select Region on Screen..." Command="{Binding SelectRegionCommand}" Margin="0,0,10,0"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="Clear Region" Command="{Binding ClearRegionCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: OCR & Preprocessing -->
            <TabItem Header="OCR &amp; Capture" Style="{StaticResource TabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <!-- OCR Engine -->
                        <Border Background="#1E293B" CornerRadius="8" Padding="14" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="OCR Engine" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock Text="Windows OCR is native and recommended for instant zero-latency capture." FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Primary Engine:" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableEngines}" SelectedItem="{Binding OcrEngineType}"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Language Tag:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding OcrLanguageTag}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Preprocessing -->
                        <Border Background="#1E293B" CornerRadius="8" Padding="14" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Image Preprocessing Filters" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock Text="Enhances recognition on stylized VN fonts and semi-transparent backgrounds." FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,10"/>

                                <CheckBox IsChecked="{Binding EnablePreprocessingUpscale}" Content="2x Bicubic Upscaling (Improves small dialogue font OCR)" Margin="0,0,0,8"/>
                                <CheckBox IsChecked="{Binding EnableAdaptiveBinarization}" Content="Contrast Stretching &amp; Adaptive Otsu Thresholding"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: Dictionary & Translation -->
            <TabItem Header="Dictionary &amp; Translation" Style="{StaticResource TabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <!-- Target Language -->
                        <Border Background="#1E293B" CornerRadius="8" Padding="14" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Translation Target Language" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Target Language:" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding AvailableTargetLanguages}"
                                              SelectedValuePath="Code"
                                              DisplayMemberPath="Name"
                                              SelectedValue="{Binding TargetLanguage}"/>
                                </Grid>

                                <CheckBox IsChecked="{Binding TranslateContextSentence}" Content="Also translate surrounding dialogue sentence for context"/>
                            </StackPanel>
                        </Border>

                        <!-- Cambridge Dictionary API Key -->
                        <Border Background="#1E293B" CornerRadius="8" Padding="14" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Cambridge Dictionary" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock Text="Leave API Key blank to use the built-in Cambridge web adapter." FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="API Key (Optional):" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding CambridgeApiKey}"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Base URL:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding CambridgeBaseUrl}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Google Translate API Key -->
                        <Border Background="#1E293B" CornerRadius="8" Padding="14" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Google Cloud Translation" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock Text="Leave blank to use the built-in zero-config Google Translate endpoint." FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,8"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="API Key (Optional):" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding GoogleTranslateApiKey}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: Appearance & Cache -->
            <TabItem Header="Appearance &amp; Cache" Style="{StaticResource TabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <!-- Appearance -->
                        <Border Background="#1E293B" CornerRadius="8" Padding="14" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Popup Behavior &amp; Appearance" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Popup Opacity:" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0.75" Maximum="1.0" Value="{Binding PopupOpacity}" SmallChange="0.01" LargeChange="0.05" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding PopupOpacity, StringFormat='{}{0:P0}'}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Auto-Dismiss Delay (s):" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="2" Maximum="20" Value="{Binding AutoCloseDelaySeconds}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding AutoCloseDelaySeconds, StringFormat='{}{0}s'}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>

                                <CheckBox IsChecked="{Binding IsDefaultPinned}" Content="Pin popup by default (prevent auto-dismissal)"/>
                            </StackPanel>
                        </Border>

                        <!-- Local SQLite Cache -->
                        <Border Background="#1E293B" CornerRadius="8" Padding="14" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Local Word Cache (SQLite)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock Text="Caches repeat lookups locally in %AppData% for instant zero-latency retrieval." FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Cached entries: " VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CachedWordsCount}" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="Clear Cache" Command="{Binding ClearCacheCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer: Status Message & Save Button -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#34D399"
                       VerticalAlignment="Center"
                       FontStyle="Italic"
                       FontSize="12"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}"
                        Content="Save Settings"
                        Command="{Binding SaveCommand}"
                        Width="120"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
