<Window x:Class="VisualNovelDetect.Views.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Dialogue Region"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#50000000"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp"
        KeyDown="Window_KeyDown">

    <Grid>
        <!-- Instructions Banner -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,40,0,0"
                Background="#0F172A"
                BorderBrush="#38BDF8"
                BorderThickness="1.5"
                CornerRadius="8"
                Padding="20,10">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="🎯 Click and drag to define the dialogue box region"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="#F8FAFC"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Press ESC to cancel • Release mouse to save"
                           FontSize="12"
                           Foreground="#94A3B8"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Canvas for Selection Rectangle -->
        <Canvas x:Name="SelectionCanvas">
            <Rectangle x:Name="RubberBand"
                       Stroke="#38BDF8"
                       StrokeThickness="2"
                       Fill="#3038BDF8"
                       Visibility="Collapsed"/>
        </Canvas>
    </Grid>
</Window>
