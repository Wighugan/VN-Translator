<Window x:Class="VisualNovelDetect.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VisualNovelDetect.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:PopupViewModel}"
        Title="Visual Novel Detect Popup"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        Width="{Binding PopupWidth, Mode=TwoWay}"
        Height="{Binding PopupHeight, Mode=TwoWay}"
        MinWidth="320"
        MinHeight="220"
        MaxWidth="900"
        MaxHeight="900"
        KeyDown="Window_KeyDown"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <Window.Resources>
        <!-- Boolean to Visibility Converter -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark-Themed ScrollBar Styles -->
        <ControlTemplate x:Key="TransparentRepeatButtonTemplate" TargetType="{x:Type RepeatButton}">
            <Rectangle Fill="Transparent"/>
        </ControlTemplate>

        <Style x:Key="ModernScrollThumb" TargetType="{x:Type Thumb}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                                Background="#475569"
                                CornerRadius="3"
                                Margin="1,0,1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#0284C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Apply Sleek Dark ScrollBar to all ScrollViews in this Window -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                          Focusable="False" IsTabStop="False"
                                                          Template="{StaticResource TransparentRepeatButtonTemplate}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ModernScrollThumb}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                          Focusable="False" IsTabStop="False"
                                                          Template="{StaticResource TransparentRepeatButtonTemplate}"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="6"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                                          Focusable="False" IsTabStop="False"
                                                          Template="{StaticResource TransparentRepeatButtonTemplate}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ModernScrollThumb}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                                          Focusable="False" IsTabStop="False"
                                                          Template="{StaticResource TransparentRepeatButtonTemplate}"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Main Card Container -->
    <Border Margin="8"
            CornerRadius="14"
            Background="#0F172A"
            BorderBrush="#334155"
            BorderThickness="1.2"
            Opacity="{Binding PopupOpacity}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270" Color="#000000" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <!-- Content Layout -->
            <Grid Margin="14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: Header -->
                    <RowDefinition Height="Auto"/> <!-- 1: Loading / Error -->
                    <RowDefinition Height="Auto"/> <!-- 2: Detected Idiom / Phrasal Verb -->
                    <RowDefinition Height="Auto"/> <!-- 3: Google Translation -->
                    <RowDefinition Height="*"/>    <!-- 4: Cambridge Dictionary Definitions -->
                </Grid.RowDefinitions>

                <!-- 1. Header: Word, IPA, POS Badge, Controls -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Word & Phonetics -->
                    <StackPanel Grid.Column="0" Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Word}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#F8FAFC"
                                       VerticalAlignment="Center"/>

                            <!-- Part of Speech Pill -->
                            <Border Margin="8,0,0,0"
                                    Background="#1E293B"
                                    BorderBrush="#475569"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasPartOfSpeech, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding PartOfSpeech}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#38BDF8"/>
                            </Border>
                        </StackPanel>

                        <!-- IPA Phonetic & Audio -->
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding PhoneticIpa}"
                                       FontSize="12"
                                       Foreground="#94A3B8"
                                       FontFamily="Segoe UI"
                                       Visibility="{Binding HasPhoneticIpa, Converter={StaticResource BoolToVis}}"/>

                            <!-- Audio Play Button -->
                            <Button Style="{StaticResource IconButton}"
                                    Command="{Binding PlayAudioCommand}"
                                    Margin="6,-2,0,0"
                                    ToolTip="Play pronunciation"
                                    Visibility="{Binding HasAudio, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="🔊" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: Action Buttons (Move Handle, Copy, Pin, Close) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <!-- Move Handle Button/Arrow -->
                        <Border x:Name="MoveHandle"
                                Cursor="SizeAll"
                                Background="#1E293B"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,3"
                                Margin="0,0,4,0"
                                ToolTip="Click and drag to move popup anywhere on screen"
                                PreviewMouseLeftButtonDown="MoveHandle_MouseDown">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✥" FontSize="12" Foreground="#38BDF8" FontWeight="Bold"/>
                                <TextBlock Text=" Move" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" Margin="3,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Copy Button -->
                        <Button Style="{StaticResource IconButton}"
                                Command="{Binding CopyDefinitionCommand}"
                                ToolTip="Copy definition">
                            <TextBlock Text="📋" FontSize="13"/>
                        </Button>

                        <!-- Pin Button: clearly displays pinned state and stops auto-dismissal -->
                        <Button Command="{Binding TogglePinCommand}"
                                ToolTip="Pin popup (prevent auto-dismissal)"
                                Background="{Binding PinButtonBackground}"
                                BorderBrush="{Binding PinButtonBorder}"
                                BorderThickness="1"
                                Cursor="Hand"
                                Padding="6,3"
                                Margin="0,0,4,0"
                                Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="{Binding PinButtonText}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding PinButtonForeground}"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Close Button -->
                        <Button Style="{StaticResource IconButton}"
                                Command="{Binding HideCommand}"
                                ToolTip="Dismiss (Esc)">
                            <TextBlock Text="✕" FontSize="13" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 2. Loading State / Progress -->
                <StackPanel Grid.Row="1" Margin="0,8,0,0" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <ProgressBar IsIndeterminate="True" Height="2" Background="#1E293B" Foreground="#38BDF8" BorderThickness="0"/>
                    <TextBlock Text="Fetching definition &amp; translation..."
                               FontSize="11"
                               Foreground="#64748B"
                               Margin="0,4,0,0"
                               FontStyle="Italic"/>
                </StackPanel>

                <!-- 2b. Error State -->
                <Border Grid.Row="1"
                        Margin="0,8,0,0"
                        Background="#2D1515"
                        BorderBrush="#7F1D1D"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,8"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠️ " FontSize="12" Foreground="#F87171"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   FontSize="12"
                                   Foreground="#FCA5A5"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 2c. Section: Detected Idiom / Phrasal Verb -->
                <Border Grid.Row="2"
                        Margin="0,8,0,0"
                        Background="#1E1C12"
                        BorderBrush="#D97706"
                        BorderThickness="1.2"
                        CornerRadius="8"
                        Padding="10,8"
                        Visibility="{Binding HasDetectedIdiom, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#B45309" CornerRadius="3" Padding="5,1">
                                <TextBlock Text="🎯 IDIOM / PHRASAL VERB"
                                           FontSize="9.5"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"/>
                            </Border>
                            <TextBlock Text="{Binding DetectedIdiomPhrase}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#FDE68A"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Idiom Meaning / Definition -->
                        <TextBlock Text="{Binding DetectedIdiomMeaning}"
                                   FontSize="12"
                                   Foreground="#F1F5F9"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>

                        <!-- Idiom Translation -->
                        <Border Margin="0,5,0,0"
                                Background="#0F172A"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Dịch: "
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#64748B"/>
                                <TextBlock Text="{Binding DetectedIdiomTranslation}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#38BDF8"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 3. Section 1: Translation (Google Translate) -->
                <Border Grid.Row="3"
                        Margin="0,8,0,0"
                        Background="#1E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,8"
                        Visibility="{Binding HasTranslation, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Language Badge & Header -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#2563EB" CornerRadius="3" Padding="5,1">
                                    <TextBlock Text="{Binding TargetLanguageDisplay}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF"/>
                                </Border>
                                <TextBlock Text="GOOGLE TRANSLATE"
                                           FontSize="9.5"
                                           FontWeight="Bold"
                                           Foreground="#64748B"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Translated Word -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding TranslatedWord}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#FACC15"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </Grid>

                        <!-- Surrounding Sentence Translation Context -->
                        <Border Margin="0,6,0,0"
                                Padding="8,5"
                                Background="#0F172A"
                                CornerRadius="6"
                                Visibility="{Binding HasSentenceTranslation, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Dialogue Sentence:"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#64748B"/>
                                <TextBlock Text="{Binding SentenceContextTranslated}"
                                           FontSize="12"
                                           Foreground="#E2E8F0"
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 4. Section 2: Cambridge Dictionary Definitions & Senses -->
                <Border Grid.Row="4"
                        Margin="0,8,0,0"
                        Visibility="{Binding HasDefinitions, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="CAMBRIDGE EXPLANATIONS"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#64748B"
                                   Margin="0,0,0,5"/>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      CanContentScroll="False"
                                      Padding="0,0,6,0">
                            <StackPanel>
                                <!-- Rich Senses (when available) -->
                                <ItemsControl ItemsSource="{Binding Senses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6"
                                                    Background="#141E33"
                                                    BorderBrush="#1E293B"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="9,7">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <!-- Part of speech pill if specific -->
                                                        <Border Background="#1E293B"
                                                                CornerRadius="3"
                                                                Padding="4,1"
                                                                Margin="0,0,4,0"
                                                                Visibility="{Binding HasPartOfSpeech, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding PartOfSpeech}"
                                                                       FontSize="9.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#38BDF8"/>
                                                        </Border>

                                                        <!-- Grammar tag (e.g. [ C ], [ T ], [ I ]) -->
                                                        <Border Background="#0F172A"
                                                                CornerRadius="3"
                                                                Padding="4,1"
                                                                Margin="0,0,4,0"
                                                                Visibility="{Binding HasGrammar, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding Grammar}"
                                                                       FontSize="9.5"
                                                                       Foreground="#A78BFA"/>
                                                        </Border>

                                                        <!-- CEFR badge (e.g. B1, B2, C1) -->
                                                        <Border Background="#064E3B"
                                                                CornerRadius="3"
                                                                Padding="4,1"
                                                                Visibility="{Binding HasCefr, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding CefrLevel}"
                                                                       FontSize="9.5"
                                                                       FontWeight="Bold"
                                                                       Foreground="#34D399"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Definition text -->
                                                    <TextBlock Text="{Binding Definition}"
                                                               FontSize="12.5"
                                                               Foreground="#E2E8F0"
                                                               LineHeight="17"
                                                               TextWrapping="Wrap"/>

                                                    <!-- Examples for this sense -->
                                                    <ItemsControl ItemsSource="{Binding Examples}" Margin="0,4,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,2,0,2"
                                                                        Padding="6,3"
                                                                        BorderBrush="#38BDF8"
                                                                        BorderThickness="2,0,0,0"
                                                                        Background="#0F1E36">
                                                                    <TextBlock Text="{Binding StringFormat='&quot;{0}&quot;'}"
                                                                               FontSize="11.5"
                                                                               FontStyle="Italic"
                                                                               Foreground="#94A3B8"
                                                                               TextWrapping="Wrap"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Flat Definitions Fallback (if Senses is empty) -->
                                <ItemsControl ItemsSource="{Binding Definitions}">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSenses}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6"
                                                    Background="#141E33"
                                                    BorderBrush="#1E293B"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="9,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="•"
                                                               FontSize="13"
                                                               Foreground="#38BDF8"
                                                               Margin="0,0,6,0"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding}"
                                                               FontSize="12.5"
                                                               Foreground="#E2E8F0"
                                                               LineHeight="17"
                                                               TextWrapping="Wrap"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Flat Examples Fallback -->
                                <ItemsControl ItemsSource="{Binding ExampleSentences}" Margin="0,2,0,0">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSenses}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,4"
                                                    Padding="8,4"
                                                    BorderBrush="#38BDF8"
                                                    BorderThickness="2,0,0,0"
                                                    Background="#0F1E36">
                                                <TextBlock Text="{Binding StringFormat='&quot;{0}&quot;'}"
                                                           FontSize="11.5"
                                                           FontStyle="Italic"
                                                           Foreground="#94A3B8"
                                                           TextWrapping="Wrap"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- 5. Bottom-Right Corner Resize Grip Handle -->
            <Border x:Name="ResizeGrip"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Width="20"
                    Height="20"
                    Cursor="SizeNWSE"
                    Background="Transparent"
                    ToolTip="Drag to resize popup window"
                    PreviewMouseLeftButtonDown="ResizeGrip_MouseDown"
                    Margin="0,0,4,4">
                <Path Data="M 14,0 L 14,14 L 0,14 Z"
                      Fill="#475569"
                      Opacity="0.8"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"/>
            </Border>
        </Grid>
    </Border>
</Window>
